# Реле помощника ФСВНГ — /etc/relay/env, права 640 root:relay.
# Секреты отсюда никуда не копировать; сам файл в репозиторий не попадает.

RELAY_SECRET=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Порядок опроса. OpenRouter бесплатно даёт 50 запросов в день (1000 после разового пополнения $10),
# Groq — порядка тысячи на модель. Groq первым = больше ёмкости, OpenRouter первым = его модели в приоритете.
PROVIDERS=openrouter,groq
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b

PORT=8443
TLS_CERT=/etc/relay/tls/fullchain.pem
TLS_KEY=/etc/relay/tls/privkey.pem
