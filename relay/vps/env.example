# Реле помощника ФСВНГ — /etc/relay/env, права 640 root:relay.
# Секреты отсюда никуда не копировать; сам файл в репозиторий не попадает.

RELAY_SECRET=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Порядок опроса. OpenRouter бесплатно даёт 50 запросов в день (1000 после разового пополнения $10),
# Groq — порядка тысячи на модель. Groq первым = больше ёмкости, OpenRouter первым = его модели в приоритете.
PROVIDERS=openrouter,groq
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b

# Самый последний рубеж — платная модель за счёт баланса OpenRouter. Пусто — рубежа нет.
# deepseek/deepseek-v4-flash: та же модель, что первая в бесплатной тройке, ~$0.15 за тысячу вопросов.
PAID_MODEL=deepseek/deepseek-v4-flash

# Эмбеддинги для поиска. МЕНЯТЬ НЕЛЬЗЯ без пересчёта векторов статей (сайт/помощник/vec.py):
# вопрос и статьи сравнимы только если их считала одна и та же модель в одной размерности.
# baai/bge-m3: 0.4 с стабильно (у qwen3-embedding-4b половина вызовов уходила в 6–17 с), 1024 измерения,
# копейки за миллион токенов. Та же открытая модель есть в Workers AI (@cf/baai/bge-m3) — векторы совместимы.
# EMBED_DIMS=0 — размерность не передаётся (у bge-m3 она фиксированная).
EMBED_MODEL=baai/bge-m3
EMBED_DIMS=0

# Журнал вопросов курсантов — только текст и время, в /var/lib/relay/questions.jsonl. 0 — выключить.
LOG_QUESTIONS=1

PORT=8443
TLS_CERT=/etc/relay/tls/fullchain.pem
TLS_KEY=/etc/relay/tls/privkey.pem
